{
  "name": "mcp-guardrails",
  "version": "0.1.0",
  "description": "Safety rails for MCP servers that let AI agents change data: dry run and confirm, signed preview tokens, optimistic concurrency, revision undo and errors that teach the agent.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "llm",
    "tool-annotations",
    "dry-run",
    "confirmation",
    "optimistic-concurrency",
    "json-merge-patch",
    "revisions",
    "undo",
    "guardrails"
  ],
  "homepage": "https://github.com/saimulft/mcp-guardrails#readme",
  "bugs": {
    "url": "https://github.com/saimulft/mcp-guardrails/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saimulft/mcp-guardrails.git"
  },
  "license": "MIT",
  "author": "Saimul Islam (https://github.com/saimulft)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint . && npm run lint:names",
    "lint:names": "ls-lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  }
}
